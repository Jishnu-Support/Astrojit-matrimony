# ==========================================
# Astrojit Backend Environment Configuration
# ==========================================

# Runtime environment (development / production)
NODE_ENV=production

# Backend Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=astrojit_super_secret_jwt_key_2026

# PostgreSQL Database Connection URL
# Set your PostgreSQL connection string here.
# When set, Astrojit connects to PostgreSQL, creates the 'astrojit_store' table,
# and automatically synchronizes all collections (clients, astrologers, vendors, products, etc.).
# Examples:
#   Supabase:   postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   Neon:       postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
#   Render:     postgres://[USER]:[PASSWORD]@[HOST].oregon-postgres.render.com/[DATABASE]
#   Railway:    postgresql://postgres:[PASSWORD]@[HOST].railway.app:5432/railway
#   Localhost:  postgresql://postgres:password@localhost:5432/astrojit
DATABASE_URL=
