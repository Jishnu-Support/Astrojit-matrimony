# ==========================================
# Astrojit Backend Environment Configuration
# ==========================================

# Runtime environment (development / production)
NODE_ENV=production

# Backend Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=astrojit_super_secret_jwt_key_2026

# Database Configuration:
# Astrojit currently runs on a high-performance, persistent file-based JSON database engine
# located at backend/data/astrojit_db.json. It does not strictly require an external DATABASE_URL to function.
# If you are integrating an external database (e.g. MongoDB or PostgreSQL), provide the connection string here:
DATABASE_URL=
